# ==============================================================================
# Society360 — Environment Variables Configuration Template
# Copy this file to .env before starting the application:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_DB=society360_db
POSTGRES_USER=society360_user
POSTGRES_PASSWORD=society360_password
DB_HOST=localhost
DB_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/society360_db
DB_USERNAME=society360_user
DB_PASSWORD=society360_password

# ------------------------------------------------------------------------------
# 2. JWT & AUTHENTICATION SECURITY
# ------------------------------------------------------------------------------
# 256-bit cryptographic secret for signing JSON Web Tokens
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION_MS=3600000        # 1 hour
JWT_REFRESH_EXPIRATION_MS=604800000     # 7 days

# ------------------------------------------------------------------------------
# 3. ROOT PLATFORM SUPER ADMINISTRATOR BOOTSTRAP
# ------------------------------------------------------------------------------
# Used to seed the initial root operator identity on fresh database startup
SUPERADMIN_EMAIL=superadmin@society360.com
SUPERADMIN_PASSWORD=Admin@12345
SUPERADMIN_NAME=Platform Super Administrator
SUPERADMIN_PHONE=+1-800-555-0199

# ------------------------------------------------------------------------------
# 4. SERVER & NETWORK PORTS
# ------------------------------------------------------------------------------
BACKEND_PORT=8080
FRONTEND_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
