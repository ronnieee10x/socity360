# Gitignore for Society360 Monorepo

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# Backend (Java / Maven)
target/
**/target/
*.class
*.log
.m2_repo/
.mvn/
**/.mvn/
backend/*.log
backend/.project
backend/.classpath
backend/.settings/
backend/*.iml
backend/.idea/

# Frontend (Node / Vite / React)
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
*.local
*.tsbuildinfo
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# Uploads & Temporary Files
uploads/
**/uploads/
temp/
tmp/

# Mobile (React Native / Expo)
mobile/node_modules/
mobile/.expo/
mobile/dist/

# IDEs & Code Editors
.vscode/
**/.vscode/
.idea/
**/.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
